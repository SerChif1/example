{
    "env": {
        "browser": true,
        "devel": true,
        "jquery": true,
        "node": true
    },
    "parserOptions": {
        "ecmaVersion": 6
    },
    "rules": {
        "camelcase": "error",
        "indent": [
            "error",
            2
        ],
        "no-undef": "error",
        "quotes": [
            "error",
            "double",
            {
                "avoidEscape": true
            }
        ],
        "max-len": [
            "error",
            {
                "code": 120
            }
        ],
        "no-trailing-spaces": "error",
        "curly": "error",
        "strict": [
            "error",
            "never"
        ]
    }
}